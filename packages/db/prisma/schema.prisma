// Peni — one product, two sides: customers (iOS, Android, web) and cafés (web panel).
// Money is stored in kuruş (Int). Peni is a whole number; 1 peni = 1 TL at the issuing café.

generator client {
  provider = "prisma-client"
  output   = "../src/generated"
}

datasource db {
  provider = "postgresql"
}

// ─────────────────────────────────────────────────────────── customers

/// A person using the customer app. Not tied to any café — they join cafés through Membership.
model Customer {
  id                  String    @id @default(cuid())
  /// E.164, e.g. +905321234567. Optional: Google, Apple and email sign-in don't give one.
  phone               String?   @unique
  /// Lower case, verified by the sign-in that gave it.
  email               String?   @unique
  displayName         String
  avatarUrl           String?
  bio                 String?   @db.VarChar(160)
  /// Profiles are hidden from other members until the customer turns this on (KVKK-friendly default).
  profileVisible      Boolean   @default(false)
  createdAt           DateTime  @default(now())
  deletionRequestedAt DateTime?

  memberships    Membership[]
  sessions       CustomerSession[]
  devices        CustomerDevice[]
  comments       PostComment[]
  reactions      PostReaction[]
  rsvps          EventRsvp[]
  hostedEvents   CafePost[]        @relation("HostedEvents")
  staffAccount   StaffAccount?
  lookups        GiftLookup[]
  claimMisses    ClaimCodeMiss[]
  customerLogins CustomerLogin[]
}

model CustomerSession {
  id          String    @id @default(cuid())
  customerId  String
  /// SHA-256 of the bearer token. The token itself is never stored.
  tokenHash   String    @unique
  deviceLabel String?
  createdAt   DateTime  @default(now())
  expiresAt   DateTime
  revokedAt   DateTime?

  customer Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@index([customerId])
}

enum LoginProvider {
  google
  apple
  email
}

/// How a customer signs in: Google's or Apple's user id, or their email address. One customer can have several.
model CustomerLogin {
  id         String        @id @default(cuid())
  customerId String
  provider   LoginProvider
  /// Google's or Apple's `sub`, or the lower-case email for email codes.
  subject    String
  email      String?
  createdAt  DateTime      @default(now())

  customer Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@unique([provider, subject])
  @@index([customerId])
}

/// A sign-in code sent by email. Only its hash is kept.
model EmailCode {
  id        String    @id
  /// Lower case.
  email     String
  codeHash  String
  createdAt DateTime  @default(now())
  expiresAt DateTime
  attempts  Int       @default(0)
  usedAt    DateTime?

  @@index([email, createdAt])
}

enum DevicePlatform {
  ios
  android
  web
}

model CustomerDevice {
  id         String         @id @default(cuid())
  customerId String
  platform   DevicePlatform
  pushToken  String         @unique
  lastSeenAt DateTime       @default(now())

  customer Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@index([customerId])
}

// ─────────────────────────────────────────────────────────── cafés

model Cafe {
  id                  String   @id @default(cuid())
  slug                String   @unique
  name                String
  address             String?
  district            String?
  city                String?
  latitude            Float?
  longitude           Float?
  coverImageUrl       String?
  timeZone            String   @default("Europe/Istanbul")
  /// Items that read peni as goods ("3 çay"). Empty: the cheapest askı items.
  referenceProductIds String[] @default([])
  /// The café's own colour, once it picks one.
  hue                 String?
  createdAt           DateTime @default(now())

  settings       CafeSettings?
  staff          StaffMember[]
  roleChanges    RolePermission[]
  tillDevices    TillDevice[]
  staffSessions  StaffSession[]
  menu           MenuItem[]
  menuCategories MenuCategory[]
  orders         Order[]
  orderCounters  OrderCounter[]
  claims         PeniClaim[]
  payments       Payment[]
  cashSessions   CashSession[]
  cashMoves      CashMove[]
  stockItems     StockItem[]
  stockMoves     StockMove[]
  recipes        StockRecipe[]
  suppliers      Supplier[]
  bills          Bill[]
  checks         DebtCheck[]
  loans          Loan[]
  loanRepayments LoanRepayment[]
  creditCard     CreditCard?
  cardPayments   CardPayment[]
  moneyStart     MoneyStart?
  moneyMoves     MoneyMovement[]
  monthCloses    MonthClose[]
  shifts         Shift[]
  shiftWeeks     ShiftWeek[]
  workDays       WorkDay[]
  payRates       PayRate[]
  payPayouts     PayPayout[]
  payCloses      PayClose[]
  taskLists      TaskList[]
  taskItems      TaskItem[]
  taskChecks     TaskCheck[]
  alertDigests   AlertDigest[]
  alertMutes     AlertMute[]
  documents      CafeDocument[]
  lineMatches    AiLineMatch[]
  drafts         AiDraft[]
  jobs           Job[]
  aiEvents       AiEvent[]
  inbox          CafeInbox?
  inboundEmails  InboundEmail[]
  memberships    Membership[]
  posts          CafePost[]
  images         CafeImage[]
}

/// Mirrors CafePeniSettings in @peni/core.
model CafeSettings {
  cafeId                    String   @id
  peniEnabled               Boolean  @default(true)
  earnRateBps               Int      @default(500)
  maxRedeemShareBps         Int      @default(10000)
  /// When false, only `redeemableProductIds` can be paid with peni.
  redeemAllProducts         Boolean  @default(true)
  redeemableProductIds      String[] @default([])
  dailyGiftLimitPeni        Int      @default(200)
  giftExpiryHours           Int      @default(24)
  askidaEnabled             Boolean  @default(true)
  askidaProductIds          String[] @default([])
  askidaClaimsPerDay        Int      @default(1)
  askidaMinMembershipDays   Int      @default(0)
  askidaMatchBps            Int      @default(0)
  askidaMatchMonthlyCapPeni Int      @default(0)
  updatedAt                 DateTime @updatedAt

  cafe Cafe @relation(fields: [cafeId], references: [id], onDelete: Cascade)
}

enum StaffRole {
  owner
  manager
  chef
  barista
}

/// A person who works at one or more cafés. Signs in with email and password.
model StaffAccount {
  id           String    @id @default(cuid())
  /// Lower case.
  email        String    @unique
  name         String
  /// bcrypt, as in Shelby, so Shelby passwords keep working. Null until set.
  passwordHash String?
  /// The same person's customer profile, when linked.
  customerId   String?   @unique
  createdAt    DateTime  @default(now())
  disabledAt   DateTime?

  customer    Customer?      @relation(fields: [customerId], references: [id], onDelete: SetNull)
  memberships StaffMember[]
  sessions    StaffSession[]
}

/// One account's role at one café. Permissions per role are in @peni/core (staff.ts) and RolePermission.
model StaffMember {
  id             String    @id @default(cuid())
  cafeId         String
  accountId      String
  role           StaffRole
  createdAt      DateTime  @default(now())
  /// Taken off the team; kept so their past posts and records still name them.
  removedAt      DateTime?
  /// bcrypt of the till PIN, set by the staff member themselves.
  pinHash        String?
  /// Wrong PINs in a row; a right one resets it.
  pinFailures    Int       @default(0)
  pinLockedUntil DateTime?

  cafe    Cafe         @relation(fields: [cafeId], references: [id], onDelete: Cascade)
  account StaffAccount @relation(fields: [accountId], references: [id], onDelete: Cascade)
  posts   CafePost[]
  devices TillDevice[]

  @@unique([cafeId, accountId])
  @@index([accountId])
}

model StaffSession {
  id        String            @id @default(cuid())
  accountId String
  /// SHA-256 of the token. The token itself is never stored.
  tokenHash String            @unique
  createdAt DateTime          @default(now())
  expiresAt DateTime
  revokedAt DateTime?
  method    StaffSignInMethod @default(password)
  /// PIN sessions belong to one café and one till device.
  cafeId    String?
  deviceId  String?

  account StaffAccount @relation(fields: [accountId], references: [id], onDelete: Cascade)
  cafe    Cafe?        @relation(fields: [cafeId], references: [id], onDelete: Cascade)
  device  TillDevice?  @relation(fields: [deviceId], references: [id], onDelete: Cascade)

  @@index([accountId])
  @@index([deviceId])
}

enum StaffSignInMethod {
  password
  pin
}

/// A computer at the café that runs the till. Set up once with a password; baristas then sign in on it with their PIN.
model TillDevice {
  id                String    @id @default(cuid())
  cafeId            String
  name              String
  /// SHA-256 of the device token. The token itself is never stored.
  tokenHash         String    @unique
  createdAt         DateTime  @default(now())
  createdByMemberId String
  lastSeenAt        DateTime?
  revokedAt         DateTime?

  cafe      Cafe           @relation(fields: [cafeId], references: [id], onDelete: Cascade)
  createdBy StaffMember    @relation(fields: [createdByMemberId], references: [id], onDelete: Cascade)
  sessions  StaffSession[]

  @@index([cafeId])
}

/// Failed staff sign-ins, for the per-email limit.
model StaffSignInFailure {
  id    String   @id @default(cuid())
  email String
  at    DateTime @default(now())

  @@index([email, at])
}

/// A café's change to one role's permission. Only differences from the defaults are stored.
model RolePermission {
  cafeId     String
  role       StaffRole
  permission String
  allowed    Boolean

  cafe Cafe @relation(fields: [cafeId], references: [id], onDelete: Cascade)

  @@id([cafeId, role, permission])
}

/// What a café sells. Edited in the Menü section of the café panel.
/// A group on the menu and a tab on the till (plan piece 5).
model MenuCategory {
  id        String   @id
  cafeId    String
  name      String
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())

  cafe     Cafe       @relation(fields: [cafeId], references: [id], onDelete: Cascade)
  products MenuItem[]

  @@unique([cafeId, name])
  @@index([cafeId, sortOrder])
}

model MenuItem {
  id          String    @id @default(cuid())
  cafeId      String
  /// Stable product id.
  productId   String
  name        String
  /// Null only for a removed product whose category was deleted later.
  categoryId  String?
  priceKurus  Int
  available   Boolean   @default(true)
  description String?
  imageUrl    String?
  /// Within its category.
  sortOrder   Int       @default(0)
  /// "Menüden kaldır": kept for past sales and reports.
  archivedAt  DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  cafe     Cafe          @relation(fields: [cafeId], references: [id], onDelete: Cascade)
  category MenuCategory? @relation(fields: [categoryId], references: [id], onDelete: SetNull)

  @@unique([cafeId, productId])
  @@index([cafeId, categoryId, sortOrder])
}

// ─────────────────────────────────────────────────────────── orders (plan piece 6)

enum OrderStatus {
  open
  paid
  voided
  refunded
}

enum PaymentMethod {
  cash
  card
  peni
  /// The askı paid for askı items given out at the till (plan piece 13).
  askida
}

/// What the till sold. Amounts in kuruş.
model Order {
  id                 String         @id
  cafeId             String
  /// Per café, from 1 each local day.
  number             Int
  /// The café's local date, YYYY-MM-DD.
  businessDay        String
  status             OrderStatus
  discountPercent    Int            @default(0)
  subtotalKurus      Int
  discountKurus      Int
  totalKurus         Int
  createdAt          DateTime
  createdByMemberId  String
  createKey          String
  paidAt             DateTime?
  paidByMemberId     String?
  paymentMethod      PaymentMethod?
  tenderedKurus      Int?
  changeKurus        Int?
  voidedAt           DateTime?
  voidedByMemberId   String?
  voidReason         String?
  refundedAt         DateTime?
  refundedByMemberId String?
  refundReason       String?
  refundKurus        Int?
  deletedAt          DateTime?
  deletedByMemberId  String?
  deleteReason       String?

  cafe     Cafe        @relation(fields: [cafeId], references: [id], onDelete: Cascade)
  lines    OrderLine[]
  claim    PeniClaim?
  payments Payment[]

  @@unique([cafeId, businessDay, number])
  @@unique([cafeId, createKey])
  @@index([cafeId, createdAt])
}

model OrderLine {
  id              String @id @default(cuid())
  orderId         String
  position        Int
  productId       String
  name            String
  unitPriceKurus  Int
  quantity        Int
  discountPercent Int    @default(0)

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@unique([orderId, position])
}

/// The last order number given out per café and day.
model OrderCounter {
  cafeId      String
  businessDay String
  last        Int

  cafe Cafe @relation(fields: [cafeId], references: [id], onDelete: Cascade)

  @@id([cafeId, businessDay])
}

// ─────────────────────────────────────────────────────────── payments (plan piece 8)

enum PaymentKind {
  sale
  refund
}

enum PaymentStatus {
  pending
  approved
  declined
  cancelled
}

/// Every sale and refund taken through a till's terminal, declined and cancelled tries included.
model Payment {
  id                String        @id
  cafeId            String
  orderId           String
  kind              PaymentKind
  method            PaymentMethod
  status            PaymentStatus
  amountKurus       Int
  tenderedKurus     Int?
  changeKurus       Int?
  /// "manual" until the till bridge drives the Ingenico.
  terminal          String
  deviceId          String?
  /// The drawer session it was taken in, when one was open.
  cashSessionId     String?
  /// The client's key; a retry finds the same payment.
  key               String
  reason            String?
  startedAt         DateTime
  startedByMemberId String
  settledAt         DateTime?
  settledByMemberId String?
  reference         String?
  receiptNo         String?
  failure           String?

  cafe        Cafe         @relation(fields: [cafeId], references: [id], onDelete: Cascade)
  order       Order        @relation(fields: [orderId], references: [id], onDelete: Cascade)
  cashSession CashSession? @relation(fields: [cashSessionId], references: [id], onDelete: SetNull)

  @@unique([cafeId, key])
  @@index([cafeId, orderId])
  @@index([cashSessionId])
  @@index([cafeId, settledAt])
}

// ─────────────────────────────────────────────────────────── cash sessions (plan piece 9)

/// The drawer from its opening count to its closing count. Amounts in kuruş.
model CashSession {
  id                     String    @id
  cafeId                 String
  /// Set to the café's id while open and cleared at closing: one open drawer per café.
  openCafeId             String?   @unique
  openedAt               DateTime
  openedByMemberId       String
  openingExpectedKurus   Int?
  openingCountKurus      Int
  openingDifferenceKurus Int
  /// Pieces per note or coin, keyed by value in kuruş.
  openingCounts          Json?
  openingNote            String?
  openKey                String
  closedAt               DateTime?
  closedByMemberId       String?
  closingExpectedKurus   Int?
  closingCountKurus      Int?
  closingDifferenceKurus Int?
  closingCounts          Json?
  closingNote            String?
  closeKey               String?

  cafe     Cafe       @relation(fields: [cafeId], references: [id], onDelete: Cascade)
  moves    CashMove[]
  payments Payment[]

  @@unique([cafeId, openKey])
  @@unique([cafeId, closeKey])
  @@index([cafeId, openedAt])
  @@index([cafeId, closedAt])
}

enum CashMoveKind {
  in
  out
}

/// Cash put into or taken out of the drawer by hand, with a reason.
model CashMove {
  id          String       @id
  cafeId      String
  sessionId   String
  kind        CashMoveKind
  amountKurus Int
  reason      String
  at          DateTime
  byMemberId  String
  key         String

  cafe    Cafe        @relation(fields: [cafeId], references: [id], onDelete: Cascade)
  session CashSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@unique([cafeId, key])
  @@index([sessionId, at])
}

// ─────────────────────────────────────────────────────────── stock (plan piece 17)

enum StockUnit {
  kg
  l
  adet
}

enum StockKind {
  ingredient
  supply
}

enum StockReason {
  start
  count
  waste
  sale
  refund
  bill
}

enum WasteWhy {
  spilled
  expired
  broken
  other
}

enum StockMode {
  recipe
  counted
  none
}

/// An ingredient or supply. Amounts are thousandths of the unit (g, ml, 1/1000 piece); they change only through StockMove.
model StockItem {
  id         String    @id
  cafeId     String
  name       String
  kind       StockKind
  unit       StockUnit
  qtyMilli   Int       @default(0)
  /// At or below this it's low; 0 means no warning.
  minMilli   Int       @default(0)
  /// Per kg, litre or piece.
  costKurus  Int?
  archivedAt DateTime?
  createdAt  DateTime  @default(now())

  cafe      Cafe              @relation(fields: [cafeId], references: [id], onDelete: Cascade)
  moves     StockMove[]
  usedIn    StockRecipeLine[]
  billLines BillLine[]

  @@index([cafeId, name])
}

/// Every change to an item's amount, with why. One batch per sale, count or waste entry.
model StockMove {
  id          String      @id
  cafeId      String
  itemId      String
  changeMilli Int
  afterMilli  Int
  reason      StockReason
  why         WasteWhy?
  note        String?
  orderId     String?
  memberId    String?
  at          DateTime
  batchKey    String

  cafe Cafe      @relation(fields: [cafeId], references: [id], onDelete: Cascade)
  item StockItem @relation(fields: [itemId], references: [id], onDelete: Cascade)

  @@unique([cafeId, batchKey, itemId])
  @@index([cafeId, at])
  @@index([itemId, at])
}

/// How a product uses stock: by recipe, as one counted piece, or not at all.
model StockRecipe {
  cafeId    String
  productId String
  mode      StockMode
  updatedAt DateTime  @updatedAt

  cafe  Cafe              @relation(fields: [cafeId], references: [id], onDelete: Cascade)
  lines StockRecipeLine[]

  @@id([cafeId, productId])
}

model StockRecipeLine {
  cafeId    String
  productId String
  itemId    String
  /// Per one of the product.
  qtyMilli  Int
  sortOrder Int    @default(0)

  recipe StockRecipe @relation(fields: [cafeId, productId], references: [cafeId, productId], onDelete: Cascade)
  item   StockItem   @relation(fields: [itemId], references: [id], onDelete: Restrict)

  @@id([cafeId, productId, itemId])
  @@index([itemId])
}

// ─────────────────────────────────────────────────────────── suppliers and bills (plan piece 18)

enum BillCategory {
  ingredients
  supplies
  rent
  utilities
  services
  wages
  other
}

enum BillPayMethod {
  cash
  card
  bank
  /// The café's credit card: owed on the card (Borçlar).
  credit
  /// A check written for it: owed until the bank pays it out.
  check
  /// Someone paid it with their own money: owed to them.
  loan
}

/// Who the café buys from. Archived instead of deleted, so old bills keep their name.
model Supplier {
  id         String    @id
  cafeId     String
  name       String
  phone      String?
  email      String?
  /// VKN or TCKN.
  taxNo      String?
  iban       String?
  note       String?
  archivedAt DateTime?
  createdAt  DateTime  @default(now())

  cafe  Cafe   @relation(fields: [cafeId], references: [id], onDelete: Cascade)
  bills Bill[]

  @@index([cafeId, name])
}

/// Every bill or receipt the café gets: stock bought, rent, a repair. Stock lines add stock.
model Bill {
  id          String    @id
  cafeId      String
  supplierId  String?
  number      String?
  /// The bill's own date in the café's time zone, YYYY-MM-DD.
  date        String
  dueDate     String?
  note        String?
  totalKurus  Int
  /// The KDV printed on it, [{ratePct, amountKurus}] (piece 25); [] when nobody entered it.
  kdv         Json      @default("[]")
  /// The scan it was confirmed from (piece 25).
  documentId  String?
  paidKurus   Int       @default(0)
  /// When the last of it was paid; null while anything is owed.
  paidAt      DateTime?
  /// Each correction adds one; stock moves of version n are batch "bill:<id>:<n>".
  version     Int       @default(1)
  voidedAt    DateTime?
  voidedById  String?
  voidReason  String?
  createdById String
  createdAt   DateTime
  updatedAt   DateTime
  createKey   String

  cafe     Cafe          @relation(fields: [cafeId], references: [id], onDelete: Cascade)
  supplier Supplier?     @relation(fields: [supplierId], references: [id], onDelete: Restrict)
  lines    BillLine[]
  payments BillPayment[]

  @@unique([cafeId, createKey])
  @@index([cafeId, date])
  @@index([cafeId, supplierId, date])
}

model BillLine {
  billId     String
  sortOrder  Int
  /// Null for a line that isn't stock.
  itemId     String?
  name       String
  category   BillCategory
  qtyMilli   Int?
  totalKurus Int

  bill Bill       @relation(fields: [billId], references: [id], onDelete: Cascade)
  item StockItem? @relation(fields: [itemId], references: [id], onDelete: Restrict)

  @@id([billId, sortOrder])
  @@index([itemId])
}

model BillPayment {
  id          String        @id
  cafeId      String
  billId      String
  amountKurus Int
  method      BillPayMethod
  /// YYYY-MM-DD in the café's time zone.
  paidOn      String
  /// Where the money came from (piece 20).
  account     MoneyAccount?
  memberId    String
  createdAt   DateTime

  bill  Bill       @relation(fields: [billId], references: [id], onDelete: Cascade)
  check DebtCheck?
  loan  Loan?

  @@index([cafeId, paidOn])
  @@index([billId])
}

// ─────────────────────────────────────────────────────────── debts (plan piece 19)

enum MoneyMethod {
  cash
  card
  bank
}

/// A check the café wrote. Owed until the bank pays it out.
model DebtCheck {
  id            String   @id
  cafeId        String
  number        String
  bankName      String?
  payee         String?
  supplierId    String?
  amountKurus   Int
  writtenOn     String
  /// The day on the check (vade), YYYY-MM-DD.
  dueDate       String
  note          String?
  /// The bill payment that wrote it; null for a check written on its own.
  billPaymentId String?  @unique
  cashedOn      String?
  cashedById    String?
  createdById   String
  createdAt     DateTime

  cafe        Cafe         @relation(fields: [cafeId], references: [id], onDelete: Cascade)
  billPayment BillPayment? @relation(fields: [billPaymentId], references: [id], onDelete: Restrict)

  @@index([cafeId, dueDate])
}

/// Money someone put in for the café. Paid back oldest first, per lender.
model Loan {
  id             String   @id
  cafeId         String
  /// "member:<id>" or "name:<lower-case name>".
  lenderKey      String
  lenderMemberId String?
  lenderName     String
  amountKurus    Int
  borrowedOn     String
  dueDate        String?
  note           String?
  billPaymentId  String?  @unique
  createdById    String
  createdAt      DateTime

  cafe        Cafe         @relation(fields: [cafeId], references: [id], onDelete: Cascade)
  billPayment BillPayment? @relation(fields: [billPaymentId], references: [id], onDelete: Restrict)

  @@index([cafeId, lenderKey, borrowedOn])
}

model LoanRepayment {
  id          String        @id
  cafeId      String
  lenderKey   String
  amountKurus Int
  method      MoneyMethod
  paidOn      String
  account     MoneyAccount?
  memberId    String
  createdAt   DateTime

  cafe Cafe @relation(fields: [cafeId], references: [id], onDelete: Cascade)

  @@index([cafeId, lenderKey, paidOn])
}

/// The café's credit card. Its charges are bill payments by "credit".
model CreditCard {
  cafeId       String   @id
  name         String
  limitKurus   Int
  statementDay Int
  dueDay       Int
  updatedAt    DateTime

  cafe Cafe @relation(fields: [cafeId], references: [id], onDelete: Cascade)
}

model CardPayment {
  id          String        @id
  cafeId      String
  amountKurus Int
  method      MoneyMethod
  paidOn      String
  account     MoneyAccount?
  memberId    String
  createdAt   DateTime

  cafe Cafe @relation(fields: [cafeId], references: [id], onDelete: Cascade)

  @@index([cafeId, paidOn])
}

// ─────────────────────────────────────────────────────────── membership & peni

model Membership {
  id         String    @id @default(cuid())
  cafeId     String
  customerId String
  joinedAt   DateTime  @default(now())
  blocked    Boolean   @default(false)
  /// Paused in the community by a moderator: reads, but can't write. Peni untouched.
  pausedAt   DateTime?
  /// Peni kodu shown at the till, e.g. "M7K-42Q".
  memberCode String?   @unique

  cafe      Cafe       @relation(fields: [cafeId], references: [id], onDelete: Cascade)
  customer  Customer   @relation(fields: [customerId], references: [id], onDelete: Cascade)
  spendCode SpendCode?

  @@unique([customerId, cafeId])
  @@index([cafeId])
}

/// A member's ödeme kodu for spending peni at the till: one at a time, valid a few minutes.
model SpendCode {
  membershipId String   @id
  cafeId       String
  code         String
  createdAt    DateTime
  expiresAt    DateTime

  membership Membership @relation(fields: [membershipId], references: [id], onDelete: Cascade)

  @@unique([cafeId, code])
}

enum LedgerKind {
  earn
  redeem
  gift_send
  gift_accept
  gift_return
  askida_donate
  askida_match
  askida_till
  askida_claim
  adjust
  reversal
}

/// Append-only. UPDATE and DELETE are rejected by a trigger (see migrations).
model LedgerTransaction {
  id             String     @id @default(cuid())
  cafeId         String
  kind           LedgerKind
  idempotencyKey String     @unique
  /// At most one reversal per transaction.
  reversesId     String?    @unique
  meta           Json       @default("{}")
  createdAt      DateTime   @default(now())

  entries LedgerEntry[]

  @@index([cafeId, kind, createdAt])
}

/// Append-only. Entries of one transaction sum to zero.
model LedgerEntry {
  id            String @id @default(cuid())
  transactionId String
  /// e.g. "member:<membershipId>", "askida:<cafeId>". See @peni/core ledger.ts.
  account       String
  delta         Int

  transaction LedgerTransaction @relation(fields: [transactionId], references: [id])

  @@index([account])
  @@index([transactionId])
}

/// Running balance per account, updated in the same DB transaction as the entries.
/// A CHECK constraint keeps member, askı and escrow balances at or above zero.
model AccountBalance {
  account   String   @id
  balance   Int      @default(0)
  updatedAt DateTime @updatedAt
}

enum GiftStatus {
  pending
  accepted
  declined
  expired
}

model Gift {
  id                String     @id
  cafeId            String
  fromMembershipId  String
  toMembershipId    String
  peni              Int
  message           String?    @db.VarChar(140)
  status            GiftStatus @default(pending)
  createdAt         DateTime   @default(now())
  expiresAt         DateTime
  resolvedAt        DateTime?
  sendTransactionId String     @unique
  thankedAt         DateTime?

  @@index([toMembershipId, status])
  @@index([fromMembershipId, createdAt])
  @@index([status, expiresAt])
}

/// One gift recipient lookup, kept for the per-hour limit.
model GiftLookup {
  id         String   @id @default(cuid())
  customerId String
  at         DateTime @default(now())

  customer Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@index([customerId, at])
}

// ─────────────────────────────────────────────────────────── community (the penny university side)

enum PostKind {
  /// Ordinary café update.
  post
  /// "Günün sorusu" — a question for members to answer under. Conversation the café can steer.
  question
  /// A penny table or a penny talk: a time, a place in the café, a topic.
  event
}

/// Café posts, questions and events. Members comment, react and RSVP.
model CafePost {
  id             String    @id @default(cuid())
  cafeId         String
  /// The staff member who posted it, when known.
  authorId       String?
  /// The member who opened this event (D4); null when the café posted it.
  hostCustomerId String?
  kind           PostKind  @default(post)
  /// Event topic.
  title          String?   @db.VarChar(200)
  body           String    @db.VarChar(2000)
  imageUrls      String[]  @default([])
  pinned         Boolean   @default(false)
  eventStartsAt  DateTime?
  eventCapacity  Int?
  publishedAt    DateTime  @default(now())
  hiddenAt       DateTime?

  cafe      Cafe           @relation(fields: [cafeId], references: [id], onDelete: Cascade)
  author    StaffMember?   @relation(fields: [authorId], references: [id])
  host      Customer?      @relation("HostedEvents", fields: [hostCustomerId], references: [id], onDelete: Cascade)
  comments  PostComment[]
  reactions PostReaction[]
  rsvps     EventRsvp[]

  @@index([cafeId, publishedAt])
}

/// A photo the café uploaded (plan piece 14), already shrunk by the browser.
model CafeImage {
  id          String   @id
  cafeId      String
  contentType String   @db.VarChar(20)
  bytes       Bytes
  /// The staff member who uploaded it.
  uploadedBy  String
  createdAt   DateTime @default(now())

  cafe Cafe @relation(fields: [cafeId], references: [id], onDelete: Cascade)

  @@index([cafeId, createdAt])
}

model PostComment {
  id         String    @id @default(cuid())
  postId     String
  customerId String
  body       String    @db.VarChar(500)
  createdAt  DateTime  @default(now())
  /// Set by staff, or automatically after enough reports.
  hiddenAt   DateTime?

  post     CafePost @relation(fields: [postId], references: [id], onDelete: Cascade)
  customer Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@index([postId, createdAt])
}

model PostReaction {
  postId     String
  customerId String
  createdAt  DateTime @default(now())

  post     CafePost @relation(fields: [postId], references: [id], onDelete: Cascade)
  customer Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@id([postId, customerId])
}

model EventRsvp {
  postId     String
  customerId String
  createdAt  DateTime @default(now())

  post     CafePost @relation(fields: [postId], references: [id], onDelete: Cascade)
  customer Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@id([postId, customerId])
}

enum ReportTarget {
  post
  comment
  profile
}

enum ReportStatus {
  open
  upheld
  dismissed
}

/// A member's report on another member's comment or event (plan piece 15).
model ContentReport {
  id         String       @id @default(cuid())
  cafeId     String
  targetType ReportTarget
  targetId   String
  /// The post the content is on: the event itself, or the comment's post.
  postId     String?
  reporterId String
  /// spam, rude, unsafe or other.
  reason     String       @db.VarChar(300)
  note       String?      @db.VarChar(300)
  status     ReportStatus @default(open)
  createdAt  DateTime     @default(now())
  resolvedAt DateTime?
  /// The staff member who looked at it.
  resolvedBy String?

  @@unique([targetType, targetId, reporterId])
  @@index([cafeId, status])
}

/// A paid order's one-time peni claim: the QR token and 4-digit code on the customer screen.
model PeniClaim {
  id                    String    @id
  cafeId                String
  orderId               String    @unique
  /// The café's local date, YYYY-MM-DD; codes are unique per café and day.
  businessDay           String
  code                  String
  token                 String    @unique
  peni                  Int
  createdAt             DateTime
  expiresAt             DateTime
  claimedAt             DateTime?
  claimedByMembershipId String?
  cancelledAt           DateTime?

  cafe  Cafe  @relation(fields: [cafeId], references: [id], onDelete: Cascade)
  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@unique([cafeId, businessDay, code])
}

/// A wrong peni code typed by a customer; a few an hour are allowed, to stop guessing.
model ClaimCodeMiss {
  id         String   @id @default(cuid())
  customerId String
  at         DateTime

  customer Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@index([customerId, at])
}

// ─────────────────────────────────────────────────────────── money accounts and month close (plan piece 20)

enum MoneyAccount {
  drawer
  reserve
  bank
}

enum MovementKind {
  opening
  transfer
  deposit
  withdraw
  correction
  bill
  check
  repayment
  card
  wages
}

/// The day the café started keeping its money in Peni, with the reserve's and the bank's opening amounts as movements.
model MoneyStart {
  cafeId    String   @id
  startedOn String
  memberId  String
  createdAt DateTime

  cafe Cafe @relation(fields: [cafeId], references: [id], onDelete: Cascade)
}

/// Money into (positive) or out of (negative) the reserve or the bank. The drawer is kept by its cash sessions.
model MoneyMovement {
  id          String        @id
  cafeId      String
  account     MoneyAccount
  amountKurus Int
  kind        MovementKind
  counterpart MoneyAccount?
  /// What made it, such as "bill_payment:<id>": one movement per source and account.
  source      String
  /// YYYY-MM-DD in the café's time zone.
  day         String
  note        String?
  memberId    String
  createdAt   DateTime

  cafe Cafe @relation(fields: [cafeId], references: [id], onDelete: Cascade)

  @@unique([cafeId, source, account])
  @@index([cafeId, account, day])
}

/// A closed month: its numbers as they were, and nothing dated in it or before it changes until it is reopened.
model MonthClose {
  id            String    @id
  cafeId        String
  /// YYYY-MM.
  month         String
  /// The month while the close stands, cleared when it is reopened: one standing close per month.
  standingMonth String?
  closedAt      DateTime
  closedById    String
  note          String?
  summary       Json
  reopenedAt    DateTime?
  reopenedById  String?
  reopenReason  String?

  cafe Cafe @relation(fields: [cafeId], references: [id], onDelete: Cascade)

  @@unique([cafeId, standingMonth])
  @@index([cafeId, closedAt])
}

// ─────────────────────────────────────────────── Vardiyalar and Puantaj ve maaş (piece 21)

/// One planned shift: a day, a start and an end, and the people on it.
model Shift {
  id           String   @id
  cafeId       String
  /// YYYY-MM-DD in the café's time zone.
  day          String
  /// Minutes after midnight; the end is after the start, at most 1440.
  startMinutes Int
  endMinutes   Int
  /// StaffMember ids.
  memberIds    String[]
  note         String?
  createdById  String
  createdAt    DateTime
  updatedAt    DateTime

  cafe Cafe @relation(fields: [cafeId], references: [id], onDelete: Cascade)

  @@index([cafeId, day])
}

/// A week (from its Monday) is a draft until it is published.
model ShiftWeek {
  cafeId        String
  weekStart     String
  publishedAt   DateTime?
  publishedById String?

  cafe Cafe @relation(fields: [cafeId], references: [id], onDelete: Cascade)

  @@id([cafeId, weekStart])
}

/// What one person worked on one day, in minutes.
model WorkDay {
  cafeId    String
  memberId  String
  day       String
  minutes   Int
  note      String?
  byId      String
  updatedAt DateTime

  cafe Cafe @relation(fields: [cafeId], references: [id], onDelete: Cascade)

  @@id([cafeId, memberId, day])
  @@index([cafeId, day])
}

/// An hourly rate from a day on, until the person's next one.
model PayRate {
  id           String   @id
  cafeId       String
  memberId     String
  fromDay      String
  kurusPerHour Int
  byId         String
  createdAt    DateTime

  cafe Cafe @relation(fields: [cafeId], references: [id], onDelete: Cascade)

  @@unique([cafeId, memberId, fromDay])
}

/// Money paid to one person against one month's pay.
model PayPayout {
  id          String        @id
  cafeId      String
  memberId    String
  /// YYYY-MM: the pay month it counts against.
  month       String
  amountKurus Int
  method      String
  account     MoneyAccount?
  paidOn      String
  note        String?
  byId        String
  createdAt   DateTime

  cafe Cafe @relation(fields: [cafeId], references: [id], onDelete: Cascade)

  @@index([cafeId, month])
  @@index([cafeId, paidOn])
}

/// A pay month closed with its hours and pay as they were.
model PayClose {
  id            String    @id
  cafeId        String
  month         String
  /// The month while the close stands, cleared when it is reopened.
  standingMonth String?
  closedAt      DateTime
  closedById    String
  note          String?
  summary       Json
  reopenedAt    DateTime?
  reopenedById  String?
  reopenReason  String?

  cafe Cafe @relation(fields: [cafeId], references: [id], onDelete: Cascade)

  @@unique([cafeId, standingMonth])
  @@index([cafeId, closedAt])
}

// ─────────────────────────────────────────────── tasks and alerts (plan piece 22)

/// "Açılış", "Kapanış": things to do on given weekdays.
model TaskList {
  id          String    @id
  cafeId      String
  name        String
  /// all, first, last, or a role
  assign      String
  sortOrder   Int
  archivedAt  DateTime?
  createdById String
  createdAt   DateTime
  updatedAt   DateTime

  cafe Cafe @relation(fields: [cafeId], references: [id], onDelete: Cascade)

  @@index([cafeId, archivedAt])
}

model TaskItem {
  id        String  @id
  cafeId    String
  listId    String
  title     String
  note      String?
  /// Monday 1 … Sunday 7
  days      Int[]
  sortOrder Int
  fromDay   String
  untilDay  String?

  cafe Cafe @relation(fields: [cafeId], references: [id], onDelete: Cascade)

  @@index([cafeId, listId])
}

/// Done or skipped on a day; the title and list name as they were then.
model TaskCheck {
  cafeId   String
  itemId   String
  day      String
  status   String
  note     String?
  title    String
  listName String
  byId     String
  at       DateTime

  cafe Cafe @relation(fields: [cafeId], references: [id], onDelete: Cascade)

  @@id([cafeId, itemId, day])
  @@index([cafeId, day])
}

/// The morning alert email, once per café and day.
model AlertDigest {
  cafeId     String
  day        String
  sentAt     DateTime
  recipients Int

  cafe Cafe @relation(fields: [cafeId], references: [id], onDelete: Cascade)

  @@id([cafeId, day])
}

/// Staff who turned the morning email off.
model AlertMute {
  cafeId   String
  memberId String

  cafe Cafe @relation(fields: [cafeId], references: [id], onDelete: Cascade)

  @@id([cafeId, memberId])
}

// ─────────────────────────────────────────────── the assistant (plan piece 24)

/// A receipt, invoice or statement the café handed the assistant. Private to the staff.
model CafeDocument {
  id          String   @id
  cafeId      String
  name        String
  contentType String   @db.VarChar(40)
  bytes       Bytes
  size        Int
  sha256      String   @db.VarChar(64)
  /// "" when it came by email.
  uploadedBy  String
  /// The email it came in (piece 26), and who sent it.
  emailId     String?
  sender      String?
  createdAt   DateTime

  cafe Cafe @relation(fields: [cafeId], references: [id], onDelete: Cascade)

  @@index([cafeId, sha256])
}

/// A café's address for bills (piece 26): <slug>.<token>@<PENI_INBOX_DOMAIN>.
model CafeInbox {
  cafeId    String   @id
  token     String   @unique @db.VarChar(16)
  enabled   Boolean  @default(true)
  createdAt DateTime
  updatedAt DateTime

  cafe Cafe @relation(fields: [cafeId], references: [id], onDelete: Cascade)
}

/// An email that reached a café's address; taken once per café.
model InboundEmail {
  id         String   @id
  cafeId     String
  providerId String
  sender     String
  subject    String
  receivedAt DateTime
  /// [{ documentId, name }]
  documents  Json     @default("[]")
  /// [{ name, why }]
  skipped    Json     @default("[]")

  cafe Cafe @relation(fields: [cafeId], references: [id], onDelete: Cascade)

  @@unique([cafeId, providerId])
  @@index([cafeId, receivedAt])
}

/// Something the assistant proposes; nothing happens until a person confirms it (D21).
model AiDraft {
  id            String    @id
  cafeId        String
  kind          String
  status        String
  title         String
  /// As the assistant wrote it.
  proposal      Json
  doubts        String[]
  documentId    String?
  jobId         String?
  createdAt     DateTime
  decidedById   String?
  decidedAt     DateTime?
  resultId      String?
  changed       String[]
  dismissReason String?
  /// An earlier bill or draft it may repeat (piece 25).
  duplicateOf   Json?
  /// A statement or Z report: what the person saw when they said it was checked (piece 27).
  outcome       Json?

  cafe Cafe @relation(fields: [cafeId], references: [id], onDelete: Cascade)

  @@index([cafeId, status, createdAt])
  @@index([cafeId, documentId])
}

/// What a person confirmed a read bill line to be, so the next bill matches it the same way (piece 25).
model AiLineMatch {
  cafeId       String
  /// "" for a bill with no supplier.
  supplierKey  String
  readKey      String
  itemId       String
  perUnitMilli Int?
  updatedAt    DateTime

  cafe Cafe @relation(fields: [cafeId], references: [id], onDelete: Cascade)

  @@id([cafeId, supplierKey, readKey])
}

/// Background work, run right after it's added and retried on later passes.
model Job {
  id          String    @id
  cafeId      String
  kind        String
  payload     Json
  status      String
  attempts    Int
  runAt       DateTime
  lockedUntil DateTime?
  lastError   String?
  result      Json?
  createdAt   DateTime
  finishedAt  DateTime?

  cafe Cafe @relation(fields: [cafeId], references: [id], onDelete: Cascade)

  @@index([status, runAt])
  @@index([cafeId, kind, createdAt])
}

/// The assistant's log: each call to the model, each draft and what people did with it.
model AiEvent {
  id           String   @id
  cafeId       String
  at           DateTime
  kind         String
  memberId     String?
  purpose      String?
  model        String?
  inputTokens  Int
  outputTokens Int
  ms           Int?
  ok           Boolean
  detail       String?
  draftId      String?
  documentId   String?
  jobId        String?

  cafe Cafe @relation(fields: [cafeId], references: [id], onDelete: Cascade)

  @@index([cafeId, at])
  @@index([cafeId, kind, at])
}
