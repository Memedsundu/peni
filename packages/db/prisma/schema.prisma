// Peni — one product, two sides: customers (iOS, Android, web) and cafés (web panel).
// Money is stored in kuruş (Int). Peni is a whole number; 1 peni = 1 TL at the issuing café.

generator client {
  provider = "prisma-client"
  output   = "../src/generated"
}

datasource db {
  provider = "postgresql"
}

// ─────────────────────────────────────────────────────────── customers

/// A person using the customer app. Not tied to any café — they join cafés through Membership.
model Customer {
  id                  String    @id @default(cuid())
  /// E.164, e.g. +905321234567. Optional: Google, Apple and email sign-in don't give one.
  phone               String?   @unique
  /// Lower case, verified by the sign-in that gave it.
  email               String?   @unique
  displayName         String
  avatarUrl           String?
  bio                 String?   @db.VarChar(160)
  /// Profiles are hidden from other members until the customer turns this on (KVKK-friendly default).
  profileVisible      Boolean   @default(false)
  createdAt           DateTime  @default(now())
  deletionRequestedAt DateTime?

  memberships    Membership[]
  sessions       CustomerSession[]
  devices        CustomerDevice[]
  comments       PostComment[]
  reactions      PostReaction[]
  rsvps          EventRsvp[]
  staffAccount   StaffAccount?
  lookups        GiftLookup[]
  customerLogins CustomerLogin[]
}

model CustomerSession {
  id          String    @id @default(cuid())
  customerId  String
  /// SHA-256 of the bearer token. The token itself is never stored.
  tokenHash   String    @unique
  deviceLabel String?
  createdAt   DateTime  @default(now())
  expiresAt   DateTime
  revokedAt   DateTime?

  customer Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@index([customerId])
}

enum LoginProvider {
  google
  apple
  email
}

/// How a customer signs in: Google's or Apple's user id, or their email address. One customer can have several.
model CustomerLogin {
  id         String        @id @default(cuid())
  customerId String
  provider   LoginProvider
  /// Google's or Apple's `sub`, or the lower-case email for email codes.
  subject    String
  email      String?
  createdAt  DateTime      @default(now())

  customer Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@unique([provider, subject])
  @@index([customerId])
}

/// A sign-in code sent by email. Only its hash is kept.
model EmailCode {
  id        String    @id
  /// Lower case.
  email     String
  codeHash  String
  createdAt DateTime  @default(now())
  expiresAt DateTime
  attempts  Int       @default(0)
  usedAt    DateTime?

  @@index([email, createdAt])
}

enum DevicePlatform {
  ios
  android
  web
}

model CustomerDevice {
  id         String         @id @default(cuid())
  customerId String
  platform   DevicePlatform
  pushToken  String         @unique
  lastSeenAt DateTime       @default(now())

  customer Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@index([customerId])
}

// ─────────────────────────────────────────────────────────── cafés

model Cafe {
  id                  String   @id @default(cuid())
  slug                String   @unique
  name                String
  address             String?
  district            String?
  city                String?
  latitude            Float?
  longitude           Float?
  coverImageUrl       String?
  timeZone            String   @default("Europe/Istanbul")
  /// Items that read peni as goods ("3 çay"). Empty: the cheapest askı items.
  referenceProductIds String[] @default([])
  /// The café's own colour, once it picks one.
  hue                 String?
  createdAt           DateTime @default(now())

  settings      CafeSettings?
  staff         StaffMember[]
  roleChanges   RolePermission[]
  tillDevices   TillDevice[]
  staffSessions StaffSession[]
  menu          MenuItem[]
  memberships   Membership[]
  posts         CafePost[]
}

/// Mirrors CafePeniSettings in @peni/core.
model CafeSettings {
  cafeId                    String   @id
  peniEnabled               Boolean  @default(true)
  earnRateBps               Int      @default(500)
  maxRedeemShareBps         Int      @default(10000)
  /// When false, only `redeemableProductIds` can be paid with peni.
  redeemAllProducts         Boolean  @default(true)
  redeemableProductIds      String[] @default([])
  dailyGiftLimitPeni        Int      @default(200)
  giftExpiryHours           Int      @default(24)
  askidaEnabled             Boolean  @default(true)
  askidaProductIds          String[] @default([])
  askidaClaimsPerDay        Int      @default(1)
  askidaMinMembershipDays   Int      @default(0)
  askidaMatchBps            Int      @default(0)
  askidaMatchMonthlyCapPeni Int      @default(0)
  updatedAt                 DateTime @updatedAt

  cafe Cafe @relation(fields: [cafeId], references: [id], onDelete: Cascade)
}

enum StaffRole {
  owner
  manager
  chef
  barista
}

/// A person who works at one or more cafés. Signs in with email and password.
model StaffAccount {
  id           String    @id @default(cuid())
  /// Lower case.
  email        String    @unique
  name         String
  /// bcrypt, as in Shelby, so Shelby passwords keep working. Null until set.
  passwordHash String?
  /// The same person's customer profile, when linked.
  customerId   String?   @unique
  createdAt    DateTime  @default(now())
  disabledAt   DateTime?

  customer    Customer?      @relation(fields: [customerId], references: [id], onDelete: SetNull)
  memberships StaffMember[]
  sessions    StaffSession[]
}

/// One account's role at one café. Permissions per role are in @peni/core (staff.ts) and RolePermission.
model StaffMember {
  id             String    @id @default(cuid())
  cafeId         String
  accountId      String
  role           StaffRole
  createdAt      DateTime  @default(now())
  /// Taken off the team; kept so their past posts and records still name them.
  removedAt      DateTime?
  /// bcrypt of the till PIN, set by the staff member themselves.
  pinHash        String?
  /// Wrong PINs in a row; a right one resets it.
  pinFailures    Int       @default(0)
  pinLockedUntil DateTime?

  cafe    Cafe         @relation(fields: [cafeId], references: [id], onDelete: Cascade)
  account StaffAccount @relation(fields: [accountId], references: [id], onDelete: Cascade)
  posts   CafePost[]
  devices TillDevice[]

  @@unique([cafeId, accountId])
  @@index([accountId])
}

model StaffSession {
  id        String            @id @default(cuid())
  accountId String
  /// SHA-256 of the token. The token itself is never stored.
  tokenHash String            @unique
  createdAt DateTime          @default(now())
  expiresAt DateTime
  revokedAt DateTime?
  method    StaffSignInMethod @default(password)
  /// PIN sessions belong to one café and one till device.
  cafeId    String?
  deviceId  String?

  account StaffAccount @relation(fields: [accountId], references: [id], onDelete: Cascade)
  cafe    Cafe?        @relation(fields: [cafeId], references: [id], onDelete: Cascade)
  device  TillDevice?  @relation(fields: [deviceId], references: [id], onDelete: Cascade)

  @@index([accountId])
  @@index([deviceId])
}

enum StaffSignInMethod {
  password
  pin
}

/// A computer at the café that runs the till. Set up once with a password; baristas then sign in on it with their PIN.
model TillDevice {
  id                String    @id @default(cuid())
  cafeId            String
  name              String
  /// SHA-256 of the device token. The token itself is never stored.
  tokenHash         String    @unique
  createdAt         DateTime  @default(now())
  createdByMemberId String
  lastSeenAt        DateTime?
  revokedAt         DateTime?

  cafe      Cafe           @relation(fields: [cafeId], references: [id], onDelete: Cascade)
  createdBy StaffMember    @relation(fields: [createdByMemberId], references: [id], onDelete: Cascade)
  sessions  StaffSession[]

  @@index([cafeId])
}

/// Failed staff sign-ins, for the per-email limit.
model StaffSignInFailure {
  id    String   @id @default(cuid())
  email String
  at    DateTime @default(now())

  @@index([email, at])
}

/// A café's change to one role's permission. Only differences from the defaults are stored.
model RolePermission {
  cafeId     String
  role       StaffRole
  permission String
  allowed    Boolean

  cafe Cafe @relation(fields: [cafeId], references: [id], onDelete: Cascade)

  @@id([cafeId, role, permission])
}

/// What a café sells. Edited in the Menü section of the café panel.
model MenuItem {
  id          String  @id @default(cuid())
  cafeId      String
  /// Stable product id.
  productId   String
  name        String
  category    String
  priceKurus  Int
  available   Boolean @default(true)
  description String?
  imageUrl    String?
  sortOrder   Int     @default(0)

  cafe Cafe @relation(fields: [cafeId], references: [id], onDelete: Cascade)

  @@unique([cafeId, productId])
}

// ─────────────────────────────────────────────────────────── membership & peni

model Membership {
  id         String   @id @default(cuid())
  cafeId     String
  customerId String
  joinedAt   DateTime @default(now())
  blocked    Boolean  @default(false)
  /// Peni kodu shown at the till, e.g. "M7K-42Q".
  memberCode String?  @unique

  cafe     Cafe     @relation(fields: [cafeId], references: [id], onDelete: Cascade)
  customer Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@unique([customerId, cafeId])
  @@index([cafeId])
}

enum LedgerKind {
  earn
  redeem
  gift_send
  gift_accept
  gift_return
  askida_donate
  askida_match
  askida_till
  askida_claim
  adjust
  reversal
}

/// Append-only. UPDATE and DELETE are rejected by a trigger (see migrations).
model LedgerTransaction {
  id             String     @id @default(cuid())
  cafeId         String
  kind           LedgerKind
  idempotencyKey String     @unique
  /// At most one reversal per transaction.
  reversesId     String?    @unique
  meta           Json       @default("{}")
  createdAt      DateTime   @default(now())

  entries LedgerEntry[]

  @@index([cafeId, kind, createdAt])
}

/// Append-only. Entries of one transaction sum to zero.
model LedgerEntry {
  id            String @id @default(cuid())
  transactionId String
  /// e.g. "member:<membershipId>", "askida:<cafeId>". See @peni/core ledger.ts.
  account       String
  delta         Int

  transaction LedgerTransaction @relation(fields: [transactionId], references: [id])

  @@index([account])
  @@index([transactionId])
}

/// Running balance per account, updated in the same DB transaction as the entries.
/// A CHECK constraint keeps member, askı and escrow balances at or above zero.
model AccountBalance {
  account   String   @id
  balance   Int      @default(0)
  updatedAt DateTime @updatedAt
}

enum GiftStatus {
  pending
  accepted
  declined
  expired
}

model Gift {
  id                String     @id
  cafeId            String
  fromMembershipId  String
  toMembershipId    String
  peni              Int
  message           String?    @db.VarChar(140)
  status            GiftStatus @default(pending)
  createdAt         DateTime   @default(now())
  expiresAt         DateTime
  resolvedAt        DateTime?
  sendTransactionId String     @unique
  thankedAt         DateTime?

  @@index([toMembershipId, status])
  @@index([fromMembershipId, createdAt])
  @@index([status, expiresAt])
}

/// One gift recipient lookup, kept for the per-hour limit.
model GiftLookup {
  id         String   @id @default(cuid())
  customerId String
  at         DateTime @default(now())

  customer Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@index([customerId, at])
}

// ─────────────────────────────────────────────────────────── community (the penny university side)

enum PostKind {
  /// Ordinary café update.
  post
  /// "Günün sorusu" — a question for members to answer under. Conversation the café can steer.
  question
  /// A penny table or a penny talk: a time, a place in the café, a topic.
  event
}

/// Café posts, questions and events. Members comment, react and RSVP.
model CafePost {
  id            String    @id @default(cuid())
  cafeId        String
  /// The staff member who posted it, when known.
  authorId      String?
  kind          PostKind  @default(post)
  /// Event topic.
  title         String?   @db.VarChar(200)
  body          String    @db.VarChar(2000)
  imageUrls     String[]  @default([])
  pinned        Boolean   @default(false)
  eventStartsAt DateTime?
  eventCapacity Int?
  publishedAt   DateTime  @default(now())
  hiddenAt      DateTime?

  cafe      Cafe           @relation(fields: [cafeId], references: [id], onDelete: Cascade)
  author    StaffMember?   @relation(fields: [authorId], references: [id])
  comments  PostComment[]
  reactions PostReaction[]
  rsvps     EventRsvp[]

  @@index([cafeId, publishedAt])
}

model PostComment {
  id         String    @id @default(cuid())
  postId     String
  customerId String
  body       String    @db.VarChar(500)
  createdAt  DateTime  @default(now())
  /// Set by staff, or automatically after enough reports.
  hiddenAt   DateTime?

  post     CafePost @relation(fields: [postId], references: [id], onDelete: Cascade)
  customer Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@index([postId, createdAt])
}

model PostReaction {
  postId     String
  customerId String
  createdAt  DateTime @default(now())

  post     CafePost @relation(fields: [postId], references: [id], onDelete: Cascade)
  customer Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@id([postId, customerId])
}

model EventRsvp {
  postId     String
  customerId String
  createdAt  DateTime @default(now())

  post     CafePost @relation(fields: [postId], references: [id], onDelete: Cascade)
  customer Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@id([postId, customerId])
}

enum ReportTarget {
  post
  comment
  profile
}

enum ReportStatus {
  open
  upheld
  dismissed
}

model ContentReport {
  id         String       @id @default(cuid())
  cafeId     String
  targetType ReportTarget
  targetId   String
  reporterId String
  reason     String       @db.VarChar(300)
  status     ReportStatus @default(open)
  createdAt  DateTime     @default(now())
  resolvedAt DateTime?

  @@unique([targetType, targetId, reporterId])
  @@index([cafeId, status])
}
