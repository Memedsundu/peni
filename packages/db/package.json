{
  "name": "@peni/db",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Peni's Postgres schema (Prisma) and the Postgres-backed ledger store.",
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "generate": "prisma generate",
    "validate": "prisma validate",
    "migrate": "prisma migrate dev",
    "migrate:deploy": "prisma migrate deploy",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "postinstall": "prisma generate"
  },
  "dependencies": {
    "@peni/core": "workspace:*",
    "@prisma/adapter-pg": "7.10.1",
    "@prisma/client": "7.10.1"
  },
  "devDependencies": {
    "@types/node": "22.20.5",
    "prisma": "7.10.1",
    "typescript": "5.9.3",
    "vitest": "5.0.5"
  }
}
