{
  "name": "peni",
  "private": true,
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "turbo run dev",
    "dev:web": "pnpm --filter @peni/web dev",
    "dev:mobile": "pnpm --filter @peni/mobile start",
    "build": "turbo run build",
    "test": "turbo run test",
    "typecheck": "turbo run typecheck",
    "lint": "turbo run lint",
    "db:generate": "pnpm --filter @peni/db generate",
    "db:migrate": "pnpm --filter @peni/db migrate",
    "brand:css": "node --experimental-strip-types packages/brand/scripts/build-css.ts",
    "brand:assets": "pnpm --filter @peni/brand make-assets"
  },
  "devDependencies": {
    "turbo": "2.11.8",
    "typescript": "5.9.3"
  }
}
