# Postgres (Neon or any Postgres 15+). Leave empty to keep everything in memory; it then resets on restart.
# Apply migrations first: DATABASE_URL=… pnpm --filter @peni/db migrate:deploy
DATABASE_URL=
# Neon's direct (not -pooler) address, for migrations only. Without it they use DATABASE_URL.
DIRECT_URL=
# Demo mode: an empty database (or the in-memory store) gets two demo cafés with their history,
# with staff accounts (leyla@moda.test is the owner; see DEMO_STAFF in src/server/seed.ts),
# and POST /api/v1/auth/demo signs in as a seeded customer. Set to 0 to turn both off.
PENI_DEMO=1
# Password of every demo staff account. Only used when demo data is created.
PENI_DEMO_STAFF_PASSWORD=demo-staff
# Customer sign-in (plan piece 3). Google and Apple: the client ids ID tokens may be issued for,
# comma-separated (web, iOS, Android). Leave empty to hide that button.
GOOGLE_CLIENT_IDS=
APPLE_CLIENT_IDS=
# Email codes go through Resend. Without a key, email sign-in is off; in demo mode codes stay
# in an outbox instead (GET /api/v1/auth/demo/outbox?email=…).
RESEND_API_KEY=
EMAIL_FROM=Peni <giris@peni.app>
# The site's own address, for links in emails (a gift email needs it).
PENI_PUBLIC_URL=
# Vercel Cron calls /api/v1/cron/daily at 05:00 UTC (08:00 in Istanbul) for the morning alert
# email; it sends this as a Bearer token. Without it the route refuses every call.
CRON_SECRET=
# The assistant (plan piece 24) reads bills, answers and writes letters with Claude.
# ANTHROPIC_MODEL defaults to claude-haiku-5-5. Without a key the demo uses a stand-in that
# doesn't really read, and anything else runs with the assistant off.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=
# OpenAI: spoken quick entry (speech to text, which Claude doesn't do), and the assistant
# instead of Claude when there's no ANTHROPIC_API_KEY. OpenAI keeps nothing (store: false).
# OPENAI_MODEL defaults to gpt-5-mini, OPENAI_TRANSCRIBE_MODEL to gpt-4o-mini-transcribe.
OPENAI_API_KEY=
OPENAI_MODEL=
