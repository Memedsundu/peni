# Demo mode: in-memory data, SMS codes are shown on screen, everything resets on restart.
PENI_DEMO=1
# Key the café panel sends as x-peni-staff-key. Change it outside local dev.
PENI_DEMO_STAFF_KEY=demo-staff

# Shelby integration (cafés with posKind = shelby)
SHELBY_BASE_URL=
SHELBY_SERVICE_TOKEN=
SHELBY_WEBHOOK_SECRET=
