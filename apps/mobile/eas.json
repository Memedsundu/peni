{
  "cli": {
    "version": ">= 16.0.0",
    "appVersionSource": "remote"
  },
  "build": {
    "preview": {
      "distribution": "internal",
      "environment": "preview",
      "env": {
        "EXPO_PUBLIC_API_URL": "https://peni-staging.vercel.app",
        "EXPO_PUBLIC_PUBLIC_URL": "https://peni-staging.vercel.app"
      }
    },
    "production": {
      "autoIncrement": true,
      "environment": "production",
      "env": {
        "EXPO_PUBLIC_API_URL": "https://peni-taupe.vercel.app",
        "EXPO_PUBLIC_PUBLIC_URL": "https://peni-taupe.vercel.app"
      }
    }
  },
  "submit": {
    "production": {
      "android": {
        "track": "internal",
        "releaseStatus": "draft"
      }
    }
  }
}
