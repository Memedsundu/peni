{
  "expo": {
    "name": "Peni",
    "slug": "peni",
    "scheme": "peni",
    "version": "0.1.0",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "ios": {
      "bundleIdentifier": "app.peni",
      "supportsTablet": false
    },
    "android": {
      "package": "app.peni",
      "edgeToEdgeEnabled": true
    },
    "plugins": ["expo-router", "expo-secure-store"],
    "experiments": { "typedRoutes": false }
  }
}
