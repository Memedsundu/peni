# Where the Peni web server runs. iOS simulator: localhost. Android emulator: 10.0.2.2. Phone on Wi-Fi: your machine's LAN IP.
EXPO_PUBLIC_API_URL=http://localhost:3000
# The public web address, for treat links people share. Defaults to the API's address.
EXPO_PUBLIC_PUBLIC_URL=
# Google sign-in: one OAuth client id per platform. The button shows only when this platform has one;
# the server needs the same ids in GOOGLE_CLIENT_IDS. Apple sign-in needs APPLE_CLIENT_IDS=app.peni on the server.
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_ANDROID_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=
